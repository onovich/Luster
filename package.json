{
  "name": "luster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node tools/build-online.mjs && node tools/build-pages.mjs",
    "build:public": "node tools/build-pages.mjs --gallery-only && node tests/publication.test.mjs",
    "test:published": "npm run build:public && node tests/online/run.cjs --gallery-only",
    "test:public": "npm run build && node tests/online/run.cjs --public-only",
    "build:online": "node tools/build-online.mjs",
    "start": "python -m http.server 8798 --bind 127.0.0.1",
    "test": "node --test tests/core.test.js tests/privacy.test.js tests/online/project.test.mjs",
    "test:online:unit": "node --test tests/online/project.test.mjs",
    "test:spectrum": "node tests/online/spectrum.cjs",
    "test:online": "npm run build:online && node tests/online/run.cjs",
    "test:layout": "npm run build:online && node tests/online/run.cjs --layout-only",
    "test:stress": "npm run build:online && node tests/online/run.cjs --stress-only",
    "test:unity:prepare": "node tests/online/unity-case.mjs all",
    "test:browser": "node tests/browser.cjs",
    "test:assets": "python tests/assets.py",
    "test:material": "node tests/material.cjs",
    "test:privacy": "node --test tests/privacy.test.js",
    "assets:pack": "node tools/pack-normals.mjs",
    "test:gallery": "node tests/gallery.cjs",
    "test:states": "node tests/states.cjs",
    "test:exhibit": "node tests/exhibit.cjs",
    "test:recovery": "node tests/recovery.cjs",
    "test:loading": "node tests/loading.cjs",
    "assets:images": "python tools/pack-images.py",
    "test:artwork": "node tests/artwork.cjs",
    "test:usability": "node tests/usability.cjs",
    "test:camera": "node tests/camera.cjs",
    "test:hover": "node tests/hover.cjs",
    "test:foil-toggle": "node tests/foil-toggle.cjs",
    "test:layers": "node tests/layers.cjs",
    "test:effects": "node tests/effects.cjs"
  },
  "description": "Art-directed spectral foil rendering in WebGL.",
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
